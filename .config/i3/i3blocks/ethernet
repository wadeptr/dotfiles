#!/usr/bin/env bash

# CONFIG
IFACE="${1:-eno1}"   # allow passing interface as argument
UP_ICON="󰈀"
DOWN_ICON="󰈂"

# Check interface exists
if ! ip link show "$IFACE" &>/dev/null; then
  echo "$DOWN_ICON $IFACE missing"
  echo "$DOWN_ICON $IFACE missing"
  echo "#bf616a"
  exit 0
fi

# Check link state
STATE=$(cat /sys/class/net/"$IFACE"/operstate 2>/dev/null)

if [[ "$STATE" != "up" ]]; then
    echo "$DOWN_ICON $IFACE down"
    echo "$DOWN_ICON $IFACE down"
    echo "#d14d41"
    exit 0
fi

# IP address
IP=$(ip -4 addr show "$IFACE" | awk '/inet / {print $2}' | cut -d/ -f1)

# Link speed (max negotiated)
SPEED=$(cat /sys/class/net/"$IFACE"/speed 2>/dev/null)
if [[ "$SPEED" == "-1" || -z "$SPEED" ]]; then
    SPEED="?"
else
    SPEED="${SPEED}Mb"
fi

# --- Live throughput calculation ---
# previous counters stored in a temporary file
TMPFILE="/tmp/i3blocks_${IFACE}_net"

RX_CUR=$(cat /sys/class/net/"$IFACE"/statistics/rx_bytes)
TX_CUR=$(cat /sys/class/net/"$IFACE"/statistics/tx_bytes)

# read previous counters
if [[ -f "$TMPFILE" ]]; then
    read RX_PREV TX_PREV <<< $(cat "$TMPFILE")
else
    RX_PREV=$RX_CUR
    TX_PREV=$TX_CUR
fi

# compute bytes/sec
RX_RATE=$((RX_CUR - RX_PREV))
TX_RATE=$((TX_CUR - TX_PREV))

# store current counters for next interval
echo "$RX_CUR $TX_CUR" > "$TMPFILE"

# convert to Mb/s
RX_MBPS=$(awk "BEGIN{printf \"%.1f\", $RX_RATE*8/1000000}")
TX_MBPS=$(awk "BEGIN{printf \"%.1f\", $TX_RATE*8/1000000}")

# --- Output for i3blocks ---
DISPLAY="$UP_ICON $IFACE $IP @ $SPEED ↓ $RX_MBPS Mb/s ↑ $TX_MBPS Mb/s"
echo "$DISPLAY"
echo "$DISPLAY"
echo "#879a39"
