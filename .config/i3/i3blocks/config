# Global properties
separator=true
separator_block_width=15

# Ethernet block
[ethernet]
command=$HOME/.config/i3/i3blocks/ethernet
interval=5

# WIFI block
[wifi]
label=WIFI:
command=SSID=$(nmcli -t -f active,ssid dev wifi | grep '^yes' | cut -d: -f2); if [ -z "$SSID" ]; then echo "OFFLINE"; echo "OFFLINE"; echo "#D14D41"; else SIGNAL=$(nmcli -t -f active,signal dev wifi | grep '^yes' | cut -d: -f2); echo "$SSID ($SIGNAL%)"; echo "$SSID ($SIGNAL%)"; fi
interval=10

# CPU block - combined usage percent, cores used, and temp
[cpu_combined]
label=CPU:
command=usage=$(grep 'cpu ' /proc/stat | awk '{usage=($2+$4)*100/($2+$4+$5)} END {printf "%.1f", usage}'); load=$(uptime | awk -F'load average:' '{ print $2 }' | cut -d, -f1 | xargs); temp=$(cat /sys/class/hwmon/hwmon3/temp[3-6]_input | awk '{sum+=$1} END {printf "%.1f", sum/NR/1000}'); echo "$usage% $load ${temp}°C"; echo "$usage%"; if [ $(echo "$usage > 90 || $temp > 80" | bc) -eq 1 ]; then echo "#D14D41"; elif [ $(echo "$usage > 70 || $temp > 70" | bc) -eq 1 ]; then echo "#D0A215"; else echo "#879A39"; fi
interval=2

# This finds the 'k10temp' (AMD CPU) folder regardless of its number. Replace the cat command above with the following if CPU temp disappears after a reboot.
# CPU_PATH=$(grep -l "k10temp" /sys/class/hwmon/hwmon*/name | sed 's/name/temp/')
# cat ${CPU_PATH}[3-6]_input

[gpu]
label=GPU:
command=util=$(nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits | awk '{printf "%.1f", $1}'); temp=$(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits | awk '{printf "%.1f", $1}'); echo "$util% $temp°C"; echo "$util%"; if [ $(echo "$temp > 80 || $util > 90" | bc) -eq 1 ]; then echo "#D14D41"; elif [ $(echo "$temp > 70 || $util > 70" | bc) -eq 1 ]; then echo "#D0A215"; else echo "#879A39"; fi
interval=5

# Memory block
[memory]
label=RAM:
command=free | awk '/Mem:/ {usage=$3/$2*100; used=$3/1024/1024; printf "%.1f%% (%.1fG)\n%.1f%%\n", usage, used, usage} END {if (usage > 90) print "#D14D41"; else if (usage > 70) print "#D0A215"; else print "#879A39"}'
interval=5

# Disk block
[disk]
label=DISK:
command=df -hl --total -x tmpfs -x devtmpfs -x squashfs -x overlay | awk '$1 == "total" {usage=$5; used=$3; gsub(/%/, "", usage); printf "%s%% (%s)\n%s%%\n", usage, used, usage} END {if (usage > 90) print "#D14D41"; else if (usage > 70) print "#D0A215"; else print "#879A39"}'
interval=60

# Date and Time block
[time]
command=date '+%m-%d-%Y %H:%M'
interval=5
